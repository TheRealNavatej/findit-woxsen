# FindIt Woxsen Server Environment Variables
PORT=5001
# Optional: MongoDB Atlas URI (If left blank, app seamlessly uses built-in memory store with all seed data)
MONGODB_URI=
# Required in production: Secret key for signing JWT tokens
JWT_SECRET=woxsen_findit_secret_key_2026_production
# Allowed origin if deploying frontend separately (e.g. https://findit-woxsen.vercel.app)
CLIENT_URL=
NODE_ENV=production
